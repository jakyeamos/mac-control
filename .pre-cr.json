{
  "version": 1,
  "testCommand": "./scripts/test-with-coverage.sh",
  "qualityCommands": [
    "swift build",
    "swift test",
    "swift test --enable-code-coverage",
    "python3 scripts/check_environment_contract.py",
    "python3 -m unittest discover -s Tests/BenchmarkTests",
    "python3 -m unittest discover -s Tests/SkillTests"
  ],
  "qualityAdapters": [
    {
      "name": "environment-contract",
      "command": "python3 scripts/check_environment_contract.py",
      "required": true
    }
  ],
  "coveragePaths": [
    "coverage/lcov.info"
  ],
  "coverageFormat": "auto",
  "threshold": 0,
  "checks": {
    "coverage": false,
    "security": true,
    "checklist": true
  },
  "excludePatterns": [
    "**/.build/**",
    "**/.swiftpm/**",
    "**/.aios/**",
    "**/Tests/**"
  ]
}
